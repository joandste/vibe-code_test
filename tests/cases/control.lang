mut

; def returns the bound value, var too
(def d1 7)
(var v1 8)

; closures
(defn make-adder [n] (fn [x] (+ x n)))
(def add5 (make-adder 5))
(add5 3)
(defn counter []
  (var n 0)
  (fn [] (set! n (inc n)) n))
(def c1 (counter))
(c1)
(c1)
(c1)
(def c2 (counter))
(c2)

; lexical scope is not dynamic
(def x 10)
(defn read-x [] x)
(let [x 20] (read-x))

; redefinition keeps existing closures on the previous value ([KW-002])
(def y 1)
(defn read-y [] y)
(def y 2)
(read-y)
y

; forward references resolve at call time
(defn calls-late [] (late))
(defn late [] :late)
(calls-late)

; sequential let bindings and shadowing
(let [a 1 b (+ a 1)] b)

