; Mutators (§10.6) and conversion (§5.8)

; arrays
(def a @[])
(push! a 1)
(push! a 2)
(push! a 3)
a
(pop! a)
a
(peek a)
(pop! @[])
(peek @[])

; mutation returns the collection
(def b @[1 2 3])
(= b (reverse! b))
b
(def c @[3 1 2])
(sort! c)
c
(def d @[3 1 2])
(sort! d (fn [x y] (> x y)))
d

; sort!/reverse! affect only the viewed range ([C-043], [C-044])
(def e @[9 3 1 8])
(sort! (slice 1 3 e))
e
(reverse! (slice 1 3 e))
e

; push! requires the array to reach the end of its buffer ([C-040a])
(def f @[1 2 3])
(push! (drop 1 f) 4)
f

; tables
(def t @{})
(put! t :a 1)
(put! t :b 2)
t
(get t :a)
(get t :missing)
(has? t :a)
(has? t :missing)
(del! t :a)
t
(length (keys t))
(length (values t))

; structs are immutable: put! and del! reject them, get/has? accept them
(get {1 :one} 1)
(has? {1 :one} 1)
(struct? {1 2})
(table? @{1 2})

; conversion ([T-029], [C-065], [C-066])
(def g @[1 2])
(= g (array g))
(array? (array (quote [1 2])))
(tuple? (tuple @[1 2]))
(bracket? (tuple @[1 2]))
(array? (array))
(tuple? (tuple))
(length (array))
(length (tuple))

; conversions copy; builders never alias their input ([T-029], [P-017])
(def h @[1 2])
(def i (array (drop 1 h)))
(push! h 3)
i
(def j (map inc h))
(push! j 99)
h
