; Values, truthiness and equality (§5.3-§5.5, §6)

; three non-values
(= true false)
(= nil false)
(= true nil)
(boolean? true)
(boolean? false)
(boolean? nil)
(nil? nil)
(nil? false)
(nil? true)

; only nil and false are falsey
(if 0 :truthy :falsey)
(if "" :truthy :falsey)
(if [] :truthy :falsey)
(if () :truthy :falsey)
(if @[] :truthy :falsey)
(if {} :truthy :falsey)
(if @{} :truthy :falsey)
(if nil :truthy :falsey)
(if false :truthy :falsey)

; structural equality with flags ([T-014], [T-015], [T-016])
(= (quote (1 2)) (quote (1 2)))
(= (quote (1 2)) (quote [1 2]))
(= (quote [1 2]) @[1 2])
(= (quote (1 2)) @(1 2))
(= @(1 2) @[1 2])
(= {1 2} @{1 2})
(= {1 2 :a 3} {1 2 :a 3})
(= @{1 2 :a 3} @{:a 3 1 2})
(= [1 [2]] [1 [2]])
(= [1 [2]] [1 @[2]])
(= "abc" "abc")
(= 1 1)
(= 1 1.0)
(= 1)
(=)
(not= 1 2)
(not= 1 1)
(not= 1 1 2)

; type names ([C-039])
(type nil)
(type true)
(type 1)
(type 1.5)
(type "s")
(type (quote s))
(type :k)
(type (quote (1)))
(type (quote [1]))
(type @[1])
(type {})
(type @{})
(type +)

; structs and tables are not sequences ([T-021], [L-005])
(empty? {})
(empty? @{})
